package Model.APPS.FREERTOS_AURIX.v4_0_4;
// Import statements
import ifx.davex.app.manifest.*

/*************** Revision History **********************************************
 Version      Date          Description
 4.0.2        12-Sep-2025   - Initial version
 4.0.4        15-Sep-2025   - License and Copyright update
 *******************************************************************************/

class  FREERTOS_AURIX extends FREERTOS_AURIX_GUI
{
	/* Note  : Following APP properties are mandatory and important */

	/* Begin : APP property section */

	/**
	 * APP version
	 * Format: a string with three digit separated by a dot.
	 */
	def version            = '4.0.4'

	/**
	 * APP categories declaration.
	 * It is list of strings. Subcategories are separated by slash.
	 * No limits on number of categories and subcategories depth.
	 */
	def categoriesDescription = ["System"]

	/**
	 * Minimum DAVE version required for this APP.
	 *
	 * It is string with three digit separated by a dot.
	 */
	def minDaveVersion           = '4.2.4'

	/**
	 * Keywords used by search feature in APPs selection view
	 *
	 * It is a list of string.
	 */
	def keywords      = ['RTOS']

	/**
	 * softwareIDs is used to declare which devices are compatible with this APP.
	 * It is a map with key a string containing a pattern that shall match the SW id of
	 * the device and as value the minimal version of the APP.
	 */

	def softwareIDs       = [
		"TC3.*.*.*":"1.0.0"]

	/**
	 * Singleton property:
	 * When it is true the APP can be instantiated only once.
	 */
	def singleton     = true


	/**
	 * initProvider property
	 * It shall be true to add a call to <AppName>_Init()
	 */
	def initProvider  = true

	/**
	 * Deprecated APP
	 * Set it to true to indicate that the APP shall be not used for new projects.
	 */
	def deprecated    = false

	/**
	 * Sharable property.
	 * It shall be true to allows multiple APPs to require the same instance of this APP.
	 */
	def sharable      = true

	/**
	 *  APP function description.
	 */
	def description = "FreeRTOS is an open source real-time operating system (RTOS) for embedded systems"

	/* End   : APP property section */

	/* Begin : User APP property section */
	MRequiredApp appres_clock
	MRequiredApp appres_cpu
	MRequiredApp appres_timer_stm
	MRequiredApp appres_timer_gtm

	MVirtualResourceGroup hwres_stm_channel
	MVirtualSignal vs_stm_sr0

	MVirtualResourceGroup hwres_int_gpsr
	MVirtualSignal vs_gpsr_trig

	MVirtualResourceGroup hwres_int_srn_0
	MVirtualResourceGroup hwres_cpu_prio_0
	MVirtualResourceGroup hwres_int_srn_1
	MVirtualResourceGroup hwres_cpu_prio_1
	MVirtualSignal vs_int_srn_0_in
	MVirtualSignal vs_int_srn_0_out
	MVirtualSignal vs_int_srn_1_in
	MVirtualSignal vs_int_srn_1_out
	MVirtualSignalRA vs_cpu_core_global
	MVirtualSignal vs_cpu_prio_0_global
	MVirtualSignal vs_cpu_prio_1_global
	SolverVariable sv_prio_stm
	SolverVariable sv_prio_gpsr

	GFloat gfloat_cpuclock = GFloat()
	GString gstring_core = GString()
	/* End   : User APP property section */

	/* Begin : APP Constructor */
	public FREERTOS_AURIX(DaveEnv daveEnv)
	{
		MF is_default = MF({return gcombo_timer_source.value == "Internal (STM)"}, Boolean)
		MF is_stm = MF({return (gcombo_timer_source.value == "APP (TIMER_STM/CMP0)" || gcombo_timer_source.value == "APP (TIMER_STM/CMP1)")}, Boolean)
		MF is_gtm = MF({return gcombo_timer_source.value == "APP (TIMER_GTM)"}, Boolean)

		appres_cpu = MRequiredApp("CPU_CORE", "CPU_CORE APP", RSHARABLE, "4.0.2", true)
		vs_cpu_core_global = MVirtualSignalRA(appres_cpu, "vs_cpu_core_global")
		gstring_core.value = MF({return appres_cpu.getVal(["gstring_core", "value"])}, String)

		appres_timer_stm = MRequiredApp("TIMER_STM", "TIMERER_STM APP", RSHARABLE, "4.0.2", is_stm)
		appres_timer_gtm = MRequiredApp("TIMER_GTM", "TIMERER_GTM APP", RSHARABLE, "4.0.2", is_gtm)
		appres_clock =  MRequiredApp("CLOCK", "CLOCK APP", RSHARABLE, "4.0.2", is_default)
		
		gfloat_cpuclock.value = MF({
			if (gcombo_timer_source.value == "Internal (STM)") {
				return appres_clock.getVal(["gfloat_fSTM", "value"])
			} else {
				return (float)0.0
			}
		}, Float)

		// The priority of sv_prio_stm must be higher than sv_prio_gpsr.
		sv_prio_gpsr = SolverVariable()
		sv_prio_stm = SolverVariable()
		addLinearConstraint(sv_prio_stm, sv_prio_gpsr, 1)

		// Get GPSR resource and correspond INT/PRIO resources.
		hwres_int_gpsr = MVirtualResourceGroup("General Purpose Service Request", ["peripheral", "int", "0", "gpsr", "*"], true)
		hwres_int_srn_1 = MVirtualResourceGroup("SW Interrupt SRN", ["peripheral", "int", "0", "srn", "*"], true)
		hwres_cpu_prio_1 = MVirtualResourceGroup("SW Interrupt", ["peripheral", "cpu", "*", "prio", sv_prio_gpsr], true)

		vs_gpsr_trig = MVirtualSignal(hwres_int_gpsr, "SW_INT", "trig0", true, true)
		vs_int_srn_1_in = MVirtualSignal(hwres_int_srn_1, "SW_INT req", "in", true, false)
		addConnectionConstraint(vs_gpsr_trig, vs_int_srn_1_in, true)

		vs_int_srn_1_out = MVirtualSignal(hwres_int_srn_1, "SW_INT", "out", true, true)
		addConnectionConstraint(vs_int_srn_1_out, vs_cpu_core_global, true)
		vs_cpu_prio_1_global = MVirtualSignal(hwres_cpu_prio_1, "global", "global", true, false)
		addConnectionConstraint(vs_cpu_core_global, vs_cpu_prio_1_global, true)

		// Get STM related INT/PRIO resources, when use Internal (STM) settings.
		hwres_stm_channel = MVirtualResourceGroup("STM Channel", ["peripheral", "stm", "*", "common"], is_default)
		hwres_int_srn_0 = MVirtualResourceGroup("Tick Interrupt SRN", ["peripheral", "int", "0", "srn", "*"], is_default)
		hwres_cpu_prio_0 = MVirtualResourceGroup("Tick Interrupt", ["peripheral", "cpu", "*", "prio", sv_prio_stm], is_default)

		vs_stm_sr0 = MVirtualSignal(hwres_stm_channel, "TICK_INT", "sr0_int", is_default, false) // always using SR0!
		vs_int_srn_0_in = MVirtualSignal(hwres_int_srn_0, "TICK_INT req", "in", is_default, false)
		addConnectionConstraint(vs_stm_sr0, vs_int_srn_0_in, is_default)

		vs_int_srn_0_out = MVirtualSignal(hwres_int_srn_0, "TICK_INT", "out", is_default, false)
		addConnectionConstraint(vs_int_srn_0_out, vs_cpu_core_global, is_default)
		vs_cpu_prio_0_global = MVirtualSignal(hwres_cpu_prio_0, "global", "global", is_default, false)
		addConnectionConstraint(vs_cpu_core_global, vs_cpu_prio_0_global, is_default)

		/* 'Use time slicing' has an effect only if preemptive scheduler is used */
		gcheck_configUSE_TIME_SLICING.enabled = MF({
			return (gcombo_configUSE_PREEMPTION.value == "Premptive")
		}, Boolean)

		/* 'Idle Task should yield' has an effect only if preemptive scheduler is used */
		gcheck_configIDLE_SHOULD_YIELD.enabled = MF({
			return (gcombo_configUSE_PREEMPTION.value == "Premptive")
		}, Boolean)

		/* Timer task priority cannot be bigger than configMAX_PRIORITIES - 1 */
		ginteger_configMAX_PRIORITIES.maxValue = MF({
			if(gcombo_configUSE_PORT_OPTIMISED_TASK_SELECTION.value == "Port Optimized") {
				return 32
			} else {
				return 256
			}
		}, Integer)

		gcombo_configMEM_ALLOC.enabled = MF({
			if (!gcheck_configSUPPORT_DYNAMIC_ALLOCATION.value) {
				return false
			}
		}, Boolean)

		ginteger_configTOTAL_HEAP_SIZE.enabled = MF({
			if (!gcheck_configSUPPORT_DYNAMIC_ALLOCATION.value) {
				return false
			}
			if ((gcombo_configMEM_ALLOC.value == "heap_3") || (gcombo_configMEM_ALLOC.value == "heap_5")) {
				return false
			} else {
				return true
			}
		}, Boolean)

		gcheck_configAPPLICATION_ALLOCATED_HEAP.enabled = MF({
			if (!gcheck_configSUPPORT_DYNAMIC_ALLOCATION.value) {
				return false
			}
			if ((gcombo_configMEM_ALLOC.value == "heap_3") || (gcombo_configMEM_ALLOC.value == "heap_5")) {
				return false
			}
			else {
				return true
			}
		}, Boolean)

		gmessage_memory_allocation.visible = MF({!gcheck_configSUPPORT_DYNAMIC_ALLOCATION.value && !gcheck_configSUPPORT_STATIC_ALLOCATION.value}, Boolean)

		/* Timer options are enabled only if timer functionality is enabled */
		ginteger_configTIMER_TASK_PRIORITY.enabled = MF({
			return gcheck_configUSE_TIMERS.value
		}, Boolean)

		ginteger_configTIMER_QUEUE_LENGTH.enabled = MF({
			return gcheck_configUSE_TIMERS.value
		}, Boolean)

		/* Timer co-routines are enabled only if co-routine functionality is enabled */
		ginteger_configMAX_CO_ROUTINE_PRIORITIES.enabled = MF({
			return gcheck_configUSE_CO_ROUTINES.value
		}, Boolean)

		/* Timer task priority cannot be bigger than configMAX_PRIORITIES - 1 */
		ginteger_configTIMER_TASK_PRIORITY.maxValue = MF({
			return (ginteger_configMAX_PRIORITIES.value - 1)
		}, Integer)

		glabel_timer_source.visible = MF({return false}, Boolean)
		gcombo_timer_source.visible = MF({return false}, Boolean)
	}
	/* End   : APP Constructor */

	/* Begin : File Generation */
	def generateFiles()
	{
		generate("FreeRTOSConfig.tmpl", "FreeRTOS-Kernel/include/FreeRTOSConfig.h")
		generate("freertos_aurix_confh.tmpl", "freertos_aurix_conf.h")
		generate("freertos_aurix_confc.tmpl", "freertos_aurix_conf.c")
		generate("freertos_aurix_privateh.tmpl", "freertos_aurix_private.h")

		copy("freertos_aurix.c", "freertos_aurix.c")
		copy("freertos_aurix.h", "freertos_aurix.h")
		copy("portmacro.h", "portmacro.h")
		copy("freertos_aurix_private.c", "freertos_aurix_private.c")
		copy("FreeRTOS-Kernel", "FreeRTOS-Kernel")
	}
	/* End   : File Generation */
}
